{
  "name": "pi-lnn-slides",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "slidev --open",
    "build": "slidev build",
    "export": "slidev export",
    "export-pdf": "slidev export --output pi-lnn-talk.pdf",
    "export-pptx": "slidev export --format pptx --per-slide --wait 2500 --wait-until networkidle --output pi-lnn-defense.pptx"
  },
  "dependencies": {
    "@slidev/cli": "^52.15.2",
    "@slidev/theme-default": "^0.25.0",
    "chart.js": "^4.5.1",
    "vue": "^3.5.34"
  },
  "devDependencies": {
    "playwright-chromium": "^1.59.1"
  }
}
